# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/work/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env.local
.env*.local

# SQLite database (datos locales - no subir a git)
/data/
*.db
*.db-shm
*.db-wal

# PDF original aportado por el usuario; la app usa el Markdown y el índice
# extraídos para poder desplegar el contexto sin versionar el archivo fuente.
/src/Un paso por delante de Wall Street.pdf

# Claude Code
.claude/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Artefactos locales generados por las hojas de investigación Lynch
/outputs/
/workbench_lynch/current_inspect/
/workbench_lynch/*.log
