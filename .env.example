DATABASE_URL=/app/data/finanzas.db
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=tu-secreto-muy-largo-aqui-minimo-32-caracteres
NEXTAUTH_URL=https://finanzas.tudominio.com
# Opcional pero recomendado: clave dedicada para cifrar secretos guardados.
# Si se omite, la app deriva el cifrado desde NEXTAUTH_SECRET.
APP_ENCRYPTION_KEY=
# La app escucha dentro del contenedor en este puerto y dirección.
PORT=3000
HOSTNAME=0.0.0.0

# Seguimiento Lynch en el VPS. Coolify mantiene el contenedor encendido y el
# scheduler hace heartbeat; solo el backend decide las ventanas Europe/Madrid.
SEGUIMIENTO_ENABLED=false
SEGUIMIENTO_WHATSAPP_ENABLED=false
AUTOMATION_SECRET=secreto-largo-y-aleatorio
AUTOMATION_USER_ID=1
SVI_NEWSLETTER_URL=https://svinvesting.substack.com/feed
# Opcional: si se configuran ambas, start.sh crea/actualiza el usuario inicial.
ADMIN_USER=
ADMIN_PASSWORD=

# Endpoint protegido para el workflow horario de n8n.
# Las credenciales reales de Telegram y SMTP permanecen exclusivamente en n8n.
AUTOMATION_SECRET=
AUTOMATION_USER_ID=

# Worker VPS: solo el valor exacto true lo activa; requiere AUTOMATION_SECRET.
# POST localhost cada 30 segundos, timeout 15 segundos; también envía heartbeat
# fuera de ventana. El backend decide ejecución y dedupe a las 08:00 y 14:00
# Europe/Madrid (incluidos cambios de horario de verano/invierno).
# AUTOMATION_USER_ID opcional se envía como query user_id.
SEGUIMIENTO_ENABLED=false

# Gmail OAuth de solo lectura (scope gmail.readonly). La cuenta autorizada debe
# corresponder al usuario AUTOMATION_USER_ID. Solo en entorno local/Coolify.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Buscador de inversiones con IA (recomendado: OpenRouter).
# La clave solo se configura en .env.local o en Coolify; nunca se guarda en Git.
BUSCADOR_ACCIONES_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Asignaciones opcionales por función; la configuración guardada en la app
# tiene prioridad sobre estas variables.
OPENROUTER_FREE_SEARCH_MODEL=openrouter/free
OPENROUTER_ADVANCED_MODEL=
OPENROUTER_SITE_URL=https://finanzas.tudominio.com
OPENROUTER_APP_NAME=Finanzas

# Alternativa opcional: OpenAI directo.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_ADVANCED_MODEL=gpt-5-mini

# Fuerza el marco local sin consultas externas.
BUSCADOR_ACCIONES_DISABLE_AI=0
