DATABASE_URL=/app/data/finanzas.db
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=tu-secreto-muy-largo-aqui-minimo-32-caracteres
NEXTAUTH_URL=https://finanzas.tudominio.com
# Opcional pero recomendado: clave dedicada para cifrar secretos guardados.
# Si se omite, la app deriva el cifrado desde NEXTAUTH_SECRET.
APP_ENCRYPTION_KEY=
# La app escucha dentro del contenedor en este puerto y dirección.
PORT=3000
HOSTNAME=0.0.0.0
# Opcional: si se configuran ambas, start.sh crea/actualiza el usuario inicial.
ADMIN_USER=
ADMIN_PASSWORD=

# Buscador de inversiones con IA (recomendado: OpenRouter).
# La clave solo se configura en .env.local o en Coolify; nunca se guarda en Git.
BUSCADOR_ACCIONES_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Asignaciones opcionales por función; la configuración guardada en la app
# tiene prioridad sobre estas variables.
OPENROUTER_FREE_SEARCH_MODEL=openrouter/free
OPENROUTER_ADVANCED_MODEL=
OPENROUTER_SITE_URL=https://finanzas.tudominio.com
OPENROUTER_APP_NAME=Finanzas

# Alternativa opcional: OpenAI directo.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_ADVANCED_MODEL=gpt-5-mini

# Fuerza el marco local sin consultas externas.
BUSCADOR_ACCIONES_DISABLE_AI=0
